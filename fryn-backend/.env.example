# Required: Groq key kept only on the backend. Free-plan quotas apply to the organization.
GROQ_API_KEY=gsk_change-me

# Required: long random password used only by you to manage installations.
FRYN_ADMIN_TOKEN=change-this-to-a-long-random-secret

# Single upstream model. Employees see only "Fryn AI".
FRYN_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Licensing
FRYN_MAX_LICENSES=12
PORT=8787
FRYN_DATA_DIR=./data

# Safety limits on each licensed desktop
FRYN_REQUESTS_PER_MINUTE=30
FRYN_MAX_BODY_MB=50
FRYN_UPSTREAM_TIMEOUT_SECONDS=45
