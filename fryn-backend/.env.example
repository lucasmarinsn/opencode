# Required: one OpenRouter API key. It stays only on this backend.
OPENROUTER_API_KEY=sk-or-v1-change-me

# Required: long random password used only by you to manage installations.
FRYN_ADMIN_TOKEN=change-this-to-a-long-random-secret

# Licensing
FRYN_MAX_LICENSES=12
PORT=8787
FRYN_DATA_DIR=./data

# Direct logical model routing. Employees see only the Fryn names.
FRYN_DEFAULT_MODEL=fryn-code
FRYN_CODE_MODEL=cohere/north-mini-code:free
FRYN_EXPERT_MODEL=poolside/laguna-m1:free
FRYN_PLAN_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional Fryn Fast route. It appears only when GROQ_API_KEY is configured.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
FRYN_FAST_MODEL=openai/gpt-oss-120b

# Optional Fryn Vision route. It appears only when GEMINI_API_KEY is configured.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FRYN_VISION_MODEL=gemini-3.6-flash

# Recommended for all-day availability. It is only reached when the free chain
# cannot serve the request. Requires OpenRouter credits and may incur charges.
FRYN_ENABLE_PAID_FALLBACK=true
FRYN_PAID_FALLBACK_MODEL=qwen/qwen3.7-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Privacy policy for upstream providers:
# allow = maximize free-provider availability
# deny  = exclude endpoints that may collect prompt/completion data
FRYN_DATA_COLLECTION=allow
# true = require Zero Data Retention endpoints. This can reduce free availability.
FRYN_REQUIRE_ZDR=false

# Optional safety limits on each licensed desktop
FRYN_REQUESTS_PER_MINUTE=30
FRYN_MAX_BODY_MB=50
FRYN_UPSTREAM_TIMEOUT_SECONDS=45
